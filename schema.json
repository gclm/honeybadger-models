{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "honeybadger-models/v1",
  "type": "object",
  "required": ["schema", "updated_at", "models"],
  "properties": {
    "schema": {"const": "honeybadger-models/v1"},
    "updated_at": {"type": "string", "format": "date"},
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "channel", "capabilities"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string"},
          "kind": {"type": "string", "enum": ["chat", "image", "audio", "video"]},
          "channel": {"type": "string", "description": "来源渠道（单值标记，供对账）"},
          "limit": {
            "type": "object",
            "properties": {
              "context": {"type": "integer", "exclusiveMinimum": 0},
              "output": {"type": "integer", "minimum": 0}
            }
          },
          "capabilities": {
            "type": "object",
            "required": ["vision", "tools"],
            "properties": {
              "vision": {"type": "boolean"},
              "tools": {"type": "boolean"},
              "reasoning": {
                "type": "object",
                "required": ["supported"],
                "properties": {
                  "supported": {"type": "boolean"},
                  "efforts": {"type": "array", "items": {"type": "string"}, "minItems": 1}
                }
              }
            }
          },
          "price": {
            "type": "object",
            "required": ["currency", "unit", "input", "output"],
            "properties": {
              "currency": {"const": "USD"},
              "unit": {"const": "per_million_tokens"},
              "input": {"type": "number"},
              "output": {"type": "number"},
              "cache_read": {"type": "number"},
              "cache_write": {"type": "number"},
              "reasoning": {"type": "number"}
            }
          },
          "aliases": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"models": {"items": {"properties": {"kind": {"const": "chat"}}}}},
        "required": ["models"]
      },
      "then": {
        "properties": {
          "models": {"items": {"required": ["id", "name", "kind", "channel", "limit", "capabilities"]}}
        }
      }
    }
  ]
}
